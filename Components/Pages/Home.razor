@page "/"
@rendermode InteractiveServer

<PageTitle>For My Love ♡</PageTitle>

<div class="love-background">

    <!-- FLOATING HEARTS -->
    <div class="floating-hearts">
        <span class="heart-float h1">♡</span>
        <span class="heart-float h2">♥</span>
        <span class="heart-float h3">♡</span>
        <span class="heart-float h4">♥</span>
        <span class="heart-float h5">♡</span>
        <span class="heart-float h6">♥</span>
        <span class="heart-float h7">♡</span>
        <span class="heart-float h8">♥</span>
        <span class="heart-float h9">♡</span>
        <span class="heart-float h10">♥</span>
    </div>


    @if (CurrentPage == 0)
    {
        <div class="card">

            <div class="heart">♡</div>

            <h1>For My Love</h1>

            <p>I have a little surprise for you... 🎀</p>

            <p>But first, tell me your name. ♡</p>

            <input @bind="Name" placeholder="Enter your name" />

            <button @onclick="CheckName">
                Continue ♡
            </button>

            @if (WrongName)
            {
                <p class="wrong">
                    Hmm... I don't think you're the one I'm looking for. 🥺
                </p>
            }

        </div>
    }


    else if (CurrentPage == 1)
    {
        <div class="card">

            <div class="heart">♥</div>

            <h1>Happy Monthsary, Love! ❤️</h1>

            <p class="subtitle">
                Another month with you,
                another month of memories to keep. ♡
            </p>

            <div class="message-box">

                <p>
                    I made something little for you...
                </p>

                <p>
                    It's not perfect, but every part of it
                    was made with you in mind. ❤️
                </p>

            </div>

            <button @onclick="NextPage">
                See Our Memories → 📸
            </button>

        </div>
    }


